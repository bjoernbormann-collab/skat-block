# ---------------------------------------------------------------------------
# CompoLog Konfiguration
# Kopieren nach .env und ausfuellen. Die .env gehoert NICHT ins Git-Repository
# und auch nicht in ein Backup, das das Haus verlaesst (sie enthaelt den
# Schluessel, mit dem die eBay-Tokens verschluesselt sind).
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true
# Mit `python -c "import secrets; print(secrets.token_urlsafe(48))"` erzeugen.
SECRET_KEY=bitte-ersetzen
# Auf true setzen, sobald die App ueber HTTPS / Cloudflare Tunnel laeuft.
SESSION_COOKIE_SECURE=false
# Komma-getrennt. Im LAN reicht *, beim Tunnel auf den Hostnamen einschraenken.
TRUSTED_HOSTS=*

# --- Datenbank ------------------------------------------------------------
# SQLite jetzt, PostgreSQL spaeter -- nur diese Zeile aendert sich:
# DATABASE_URL=postgresql+psycopg://compolog:passwort@localhost/compolog
DATABASE_URL=sqlite:///./data/compolog.db
DATABASE_ECHO=false

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Nummernkreise --------------------------------------------------------
SKU_SCHEMA=CL-{counter:06d}
SKU_START=1000

# --- Firmendaten (Pflichtangaben §14 UStG auf jedem Beleg) ----------------
COMPANY_NAME=
COMPANY_STREET=
COMPANY_ZIP=
COMPANY_CITY=
COMPANY_COUNTRY=DE
COMPANY_VAT_ID=
COMPANY_TAX_NUMBER=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_BANK_NAME=
COMPANY_IBAN=
COMPANY_BIC=
COMPANY_REGISTER=
COMPANY_MANAGING_DIRECTOR=
# true = Kleinunternehmer nach §19 UStG (Rechnungen ohne USt-Ausweis)
SMALL_BUSINESS_SCHEME=false
DEFAULT_VAT_RATE=19.00

# --- eBay -----------------------------------------------------------------
# Erst mit Sandbox arbeiten. Umschalten auf false erzeugt echte Angebote.
EBAY_SANDBOX=true
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_SYNC_INTERVAL_MINUTES=15
# set_zero = Angebot bleibt mit Menge 0 online, end_offer = Angebot wird beendet
EBAY_ZERO_STOCK_ACTION=set_zero

# --- DHL Geschaeftskundenversand -----------------------------------------
DHL_SANDBOX=true
DHL_API_KEY=
DHL_USERNAME=
DHL_PASSWORD=
DHL_BILLING_NUMBER=

# --- Backup ---------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_CRON_HOUR=3
BACKUP_KEEP_DAYS=30
